---
// ShellSession: the command and output fences of a shell session as one frame. Fences alternate by
// position (odd = command, even = output); each keeps its own language. The entries are the
// rendered Expressive Code blocks of the slot, marked in place; the style below fuses them.
import { topLevel } from '../starlight/tab-icons.mjs';
import { slimTokens } from './shell-session.mjs';

export interface Props {
  /** Title bar text; also the name of the group. */
  title?: string;
  /** Type each command in a loop (40 ms per character), its output appearing after it. Still under reduced motion. */
  play?: boolean;
}

const { title, play = false } = Astro.props;
const html = await Astro.slots.render('default');
const { tokens, at, rest } = topLevel(html, (tag) => /\sclass="(?:[^"]*\s)?expressive-code(?:\s[^"]*)?"/.test(tag));
// Expressive Code's hoisted stylesheet link and module script may sit beside the blocks.
const stray = rest.find((tag) => tag.trim() && !/^<(?:link\s|script[\s>])/i.test(tag));
if (at.length === 0) throw new Error('<ShellSession> needs at least one code fence in its slot.');
if (stray !== undefined) throw new Error(`<ShellSession> holds only code fences, found ${stray.trim()}.`);
const LINE = '<div class="ec-line';
/** Marks each line after one ending in `\` as a continuation: it keeps the `$`'s width, so its indent holds, but no `$`. */
const continued = (block: string): string => {
  const [head = '', ...lines] = block.split(LINE);
  const text = (line: string) => (line.split('</code>')[0] ?? '').replace(/<[^>]*>/g, '').trimEnd();
  return (
    head +
    lines
      .map(
        (l, k) =>
          (k > 0 && text(lines[k - 1] ?? '').endsWith('\\') ? '<div data-ocx-continued class="ec-line' : LINE) + l,
      )
      .join('')
  );
};
for (const [n, i] of at.entries()) {
  const kind = n % 2 ? 'output' : 'command';
  tokens[i] = (tokens[i] ?? '').replace(
    '<div',
    `<div data-ocx-session="${kind}" role="group" aria-label="${kind === 'output' ? 'Output' : 'Command'}"`,
  );
}
// A marked block runs to the next marker, so each command's lines are one piece.
const MARK = '<div data-ocx-session="';
const body = slimTokens(tokens.join(''))
  .split(MARK)
  .map((piece, k) => (k > 0 && piece.startsWith('command') ? continued(piece) : piece))
  .join(MARK);
---

<div
  class="ocx-shell-session not-content"
  role="group"
  aria-label={title ?? 'Shell session'}
  data-ocx-play={play ? '' : undefined}
>
  {title && <div class="ocx-shell-session-header">{title}</div>}
  <Fragment set:html={body} />
</div>

<script>
  import { onRoots } from './ui/roots.mjs';
  import { mount } from './ui/lazy.mjs';

  onRoots('.ocx-shell-session[data-ocx-play]', (root) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    mount(root, { load: () => import('./shell-session-play.mjs'), trigger: 'visible', replay: false });
  });
</script>

<style is:global>
  @layer ocx {
    /* Its Expressive Code blocks fused into one terminal surface. EC's own border and radius go (zeroed through
       its variables, so no rule needs to out-specify EC's); the session draws one border and a title bar that
       replaces the frames' headers. Entries are consecutive terminal lines: no padding between them, the code
       padding only above the first and below the last. A command line wears an accent `$` and EC's copy
       button; an output line a `>`, both in the comment colour, and no copy button. The markers are generated
       content: neither selected nor copied (EC copies `data-code`). Component CSS rather than starlight.css:
       story pages and other hosts load no Starlight sheet. */
    .ocx-shell-session {
      overflow: hidden;
      border: var(--ocx-border-width) solid var(--ocx-color-border);
      border-radius: var(--ocx-radius-lg);
    }
    .ocx-shell-session-header {
      box-sizing: border-box;
      display: flex;
      align-items: center;
      block-size: calc(var(--ocx-control-md) + 2 * var(--ocx-space-2));
      padding-inline: var(--ocx-space-4);
      font-family: var(--ocx-font-mono);
      font-size: var(--ocx-text-xs);
      font-weight: var(--ocx-font-weight-semibold);
      color: var(--ocx-color-fg);
      background: var(--ocx-color-surface-subtle);
      border-block-end: var(--ocx-border-width) solid var(--ocx-color-border);
    }
    .ocx-shell-session > .expressive-code {
      --ec-brdWd: 0px;
      --ec-brdRad: 0px;
      --ec-codePadBlk: 0px;
      margin: 0;
    }
    .ocx-shell-session .frame .header {
      display: none;
    }
    .ocx-shell-session-header + .expressive-code pre,
    .ocx-shell-session > .expressive-code:first-child pre {
      padding-block-start: var(--ocx-space-5);
    }
    .ocx-shell-session > .expressive-code:last-child pre {
      padding-block-end: var(--ocx-space-5);
    }
    /* A command's copy button is one code line tall and flush with the first line, so it never reaches the next
       entry. The tripled class outranks starlight.css's (0,4,0) untitled-terminal spacing: a tie loses wherever
       starlight.css loads later, as on story pages. */
    .ocx-shell-session > [data-ocx-session='command'] .frame.frame.frame {
      --button-spacing: 0px;
      --ocx-shell-line: calc(var(--ec-codeFontSize) * var(--ec-codeLineHt));
    }
    .ocx-shell-session-header + .expressive-code .copy,
    .ocx-shell-session > .expressive-code:first-child .copy {
      margin-block-start: var(--ocx-space-5);
    }
    .ocx-shell-session > [data-ocx-session='command'] .copy button {
      inline-size: var(--ocx-shell-line);
      block-size: var(--ocx-shell-line);
      opacity: 1;
    }
    /* The copied pill matches: at its default control height it overlaps the next entry. */
    .ocx-shell-session > [data-ocx-session='command'] .copy .feedback {
      block-size: var(--ocx-shell-line);
    }
    .ocx-shell-session > [data-ocx-session='command'] .copy button::after {
      inline-size: var(--ocx-icon-md);
      block-size: var(--ocx-icon-md);
      margin: auto;
      mask-size: contain;
    }
    .ocx-shell-session > [data-ocx-session='output'] .copy {
      display: none;
    }
    .ocx-shell-session .code::before {
      content: '$ ';
      color: var(--ocx-color-accent-fg);
      user-select: none;
    }
    /* A `\` continuation line hides its `$` but keeps the space, so its indent does not shift. */
    .ocx-shell-session [data-ocx-continued] .code::before {
      visibility: hidden;
    }
    /* EC colours each token through an inline custom property, so `color` has to be set on the spans too. */
    .ocx-shell-session > [data-ocx-session='output'] .code,
    .ocx-shell-session > [data-ocx-session='output'] .code span {
      color: var(--ocx-color-code-comment);
    }
    .ocx-shell-session > [data-ocx-session='output'] .code::before {
      content: '> ';
      color: inherit;
    }
    @media (forced-colors: active) {
      .ocx-shell-session-header {
        border-block-end-color: CanvasText;
      }
    }
  }
</style>
