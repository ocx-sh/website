---
// AlertDialog (Track G, owner finding: "predefined Confirm, Error, … dialogs for quick use").
// A preset on top of Dialog.astro (C-172): `role=alertdialog` (Zag's own prop, not a rebuild), a
// tone icon in the header slot, one acknowledge button. No trigger slot — place once, open with
// `ocx:dialog:open` (detail `{ id }`), read the outcome off `ocx:dialog-result` (detail `{ id, value }`:
// 'ok', or 'dismiss' for Esc/X/outside click); Dialog.astro emits it once per close.
import Button from './Button.astro';
import Dialog from './Dialog.astro';
import Icon from './Icon.astro';
import { nextUiId } from './ids.mjs';

type Tone = 'info' | 'success' | 'warning' | 'error';

interface Props {
  /** Also what `ocx:dialog:open` / `ocx:dialog-result` key on. Defaults to an auto id. */
  id?: string;
  title: string;
  message?: string;
  tone?: Tone;
  acknowledgeLabel?: string;
}

const { id = nextUiId('alert'), title, message, tone = 'info', acknowledgeLabel = 'OK' } = Astro.props;
---

<Dialog id={id} title={title} description={message} zag={{ role: 'alertdialog' }}>
  <span slot="icon" class="ocx-ui-alert__icon" data-tone={tone}>
    <Icon name={tone} />
  </span>
  <div class="ocx-ui-alert__actions">
    <Button variant="primary" data-dialog-action="ok">
      {acknowledgeLabel}
    </Button>
  </div>
</Dialog>

<style>
  @layer ocx {
    .ocx-ui-alert__icon {
      display: contents; /* the Dialog icon box centres the svg; this wrapper adds no line box */
    }
    /* Neutral ink for info: accent (coral) stays reserved for links, primary actions and focus. */
    .ocx-ui-alert__icon[data-tone='info'] {
      color: var(--ocx-color-fg-muted);
    }
    .ocx-ui-alert__icon[data-tone='success'] {
      color: var(--ocx-color-success);
    }
    .ocx-ui-alert__icon[data-tone='warning'] {
      color: var(--ocx-color-warning);
    }
    .ocx-ui-alert__icon[data-tone='error'] {
      color: var(--ocx-color-danger);
    }
    .ocx-ui-alert__actions {
      display: flex;
      justify-content: flex-end;
      margin-block-start: var(--ocx-space-6);
    }
  }
</style>
