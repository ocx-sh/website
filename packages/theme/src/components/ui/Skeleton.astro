---
// Skeleton: placeholder bars that reserve the final box (no-flicker rule). Decorative only; pair it
// with a <Loader> for the announcement. One component, variants by prop (D-R4): the primitives
// `text` (default), `circle`, `rect` and the composites `card`, `list`, `table`, `code`, `terminal`.
// Each composite takes its block size from the same classes and tokens as the real component
// (D-R5): `.ocx-card`, the List row, the DataTable cells, the Expressive Code frame, the Terminal
// chrome and player; the swap story and e2e hold them to ±1px. A faint sweep crosses every bar
// (shimmer, still under reduced motion: it stands still there, D-R6); `animated={false}` turns it off.
// Styles: the text primitive and the sweep in skeleton.css (loaded by base.css), the variants below
// (global: the BEM names are the scope, and Astro's per-selector scope hashes would push the sheet
// past the inline-CSS cap).
export interface Props {
  variant?: 'text' | 'circle' | 'rect' | 'card' | 'list' | 'table' | 'code' | 'terminal';
  /** Bars to reserve for `text`, `code` and `terminal` (each one line-height tall). */
  lines?: number;
  /** A `code` block's source: its line count (a trailing newline does not add one) sets the bars, over `lines`. */
  code?: string;
  /** A `code` block with a title bar: reserves Expressive Code's 36px header. The text itself is not drawn. */
  title?: string | boolean;
  /** Rows of a `list` or `table` (a table's head row comes on top); a `terminal`'s rows, with `cols`. */
  rows?: number;
  /** A `terminal`'s columns: with `rows`, the size of the Terminal it stands in for, so it reserves that Terminal's player box. */
  cols?: number;
  /** Columns of a `table`. */
  columns?: number;
  /** Diameter of a `circle`, on Avatar's scale. */
  size?: 'sm' | 'md' | 'lg';
  /** Aspect ratio of a `rect`, `width / height`. */
  ratio?: string;
  /** The sweep across the bars. */
  animated?: boolean;
  class?: string;
}

const {
  variant = 'text',
  lines = 3,
  code,
  title,
  rows = 3,
  cols,
  columns = 3,
  size = 'sm',
  ratio = '16 / 9',
  animated = true,
  class: className,
} = Astro.props;
// Written into `style`, so it is checked: a number over a number.
if (!/^\d+(\.\d+)?\s*\/\s*\d+(\.\d+)?$/.test(ratio)) throw new Error(`Skeleton: invalid ratio "${ratio}"`);

const count = (n: number) => Array.from({ length: n });
// A code block's source sets its bars, as a fence's does its lines: EC trims trailing newlines.
const bars = variant !== 'code' || code === undefined ? lines : code.replace(/\n+$/, '').split('\n').length;
const style = {
  text: `--_lines: ${lines}`,
  // No player floor (`--_min`), code padding (`--_pad`); a title bar is EC's 36px header (control-md + 2 × space-2, starlight.css),
  // its first pixel the root's border-top and its last the body's border-top. Inline, not in the <style>, to keep this sheet under the inline-CSS cap (see `terminal`).
  code: `--_lines: ${bars}; --_min: 0px; --_pad: var(--ocx-space-5)${title ? '; --_head: calc(var(--ocx-control-md) + 2 * var(--ocx-space-2) - 2 * var(--ocx-border-width))' : ''}`,
  // A sized Terminal's player height: Terminal.astro's reserve calc, change both together. Inline, not in the
  // <style>: it keeps this sheet under the plugin's inline-CSS cap (an external sheet costs Lighthouse 0.01).
  terminal: cols
    ? `--_lines: ${lines}; --_min: calc(100cqi * ${rows * 20 + 22} / ${cols * 9 + 22} + 32px)`
    : `--_lines: ${lines}`,
  list: `--_rows: ${rows}`,
  table: `--_rows: ${rows}; --_cols: ${columns}`,
  rect: `--_ratio: ${ratio}`,
  circle: undefined,
  card: undefined,
}[variant];
---

<span
  class:list={['ocx-ui-skeleton', variant === 'card' && 'ocx-card', className]}
  aria-hidden="true"
  style={style}
  data-variant={variant === 'text' ? undefined : variant}
  data-size={variant === 'circle' ? size : undefined}
  data-animated={animated ? undefined : 'false'}
>
  {variant === 'card' ? (
    <>
      <span class="ocx-ui-skeleton__line" />
      <span class="ocx-ui-skeleton__line" />
    </>
  ) : variant === 'list' ? (
    count(rows).map(() => (
      <span class="ocx-ui-skeleton__row">
        <span class="ocx-ui-skeleton__line" />
      </span>
    ))
  ) : variant === 'table' ? (
    count(rows + 1).map((_, r) => (
      <span class="ocx-ui-skeleton__tr" data-head={r === 0 ? '' : undefined}>
        {count(columns).map(() => (
          <span class="ocx-ui-skeleton__cell">
            <span class="ocx-ui-skeleton__line" />
          </span>
        ))}
      </span>
    ))
  ) : variant === 'terminal' || variant === 'code' ? (
    <>
      {(variant === 'terminal' || title) && (
        <span class="ocx-ui-skeleton__chrome">
          <span class="ocx-ui-skeleton__line" />
        </span>
      )}
      <span class="ocx-ui-skeleton__body">
        {count(bars).map(() => (
          <span class="ocx-ui-skeleton__line" />
        ))}
      </span>
    </>
  ) : variant === 'circle' || variant === 'rect' ? (
    <span class="ocx-ui-skeleton__line" />
  ) : (
    count(lines).map(() => <span class="ocx-ui-skeleton__line" />)
  )}
</span>

<style is:global>
  @layer ocx {
    /* Primitives. */
    .ocx-ui-skeleton[data-variant='circle'] {
      --_size: var(--ocx-control-sm);
      display: inline-flex;
    }
    .ocx-ui-skeleton[data-variant='circle'][data-size='md'] {
      --_size: var(--ocx-control-lg);
    }
    .ocx-ui-skeleton[data-variant='circle'][data-size='lg'] {
      --_size: var(--ocx-control-2xl);
    }
    .ocx-ui-skeleton[data-variant='circle'] > .ocx-ui-skeleton__line {
      inline-size: var(--_size);
      block-size: var(--_size);
      border-radius: var(--ocx-radius-full);
    }
    .ocx-ui-skeleton[data-variant='rect'] {
      display: block;
    }
    .ocx-ui-skeleton[data-variant='rect'] > .ocx-ui-skeleton__line {
      inline-size: 100%;
      block-size: auto;
      aspect-ratio: var(--_ratio);
    }

    /* Composites: a bar sits in a 1lh row (0.2lh above and below), as a line of text does. */
    .ocx-ui-skeleton:is(
      [data-variant='card'],
      [data-variant='list'],
      [data-variant='table'],
      [data-variant='code'],
      [data-variant='terminal']
    ) {
      --_m: 0.2lh;
    }
    /* Card: the .ocx-card box (class on the root); a title bar over one line of text. */
    .ocx-ui-skeleton[data-variant='card'] > .ocx-ui-skeleton__line:first-child {
      inline-size: 40%; /* ponytail: raw until a skeleton token exists */
    }
    /* List: the List's content box and row (base.css-free copy of the same tokens). */
    .ocx-ui-skeleton[data-variant='list'] {
      --_bar: var(--ocx-color-border);
      display: flex;
      flex-direction: column;
      gap: var(--ocx-space-1);
      padding: var(--ocx-space-2);
      font-size: var(--ocx-text-sm);
      background: var(--ocx-color-surface-subtle);
      border: var(--ocx-border-width) solid var(--ocx-color-border);
      border-radius: var(--ocx-radius-lg);
    }
    .ocx-ui-skeleton__row {
      display: block;
      padding: var(--ocx-space-2) var(--ocx-space-3);
    }
    /* Table: the DataTable region, head row and cells. */
    .ocx-ui-skeleton[data-variant='table'] {
      display: flex;
      flex-direction: column;
      overflow: clip;
      font-size: var(--ocx-text-base);
      line-height: var(--ocx-lh-heading);
      background: var(--ocx-color-surface);
      border: var(--ocx-border-width) solid var(--ocx-color-border);
      border-radius: var(--ocx-radius-lg);
    }
    .ocx-ui-skeleton__tr {
      display: grid;
      grid-template-columns: repeat(var(--_cols), minmax(0, 1fr));
      border-block-end: var(--ocx-border-width) solid var(--ocx-color-border);
    }
    .ocx-ui-skeleton__tr:last-child {
      border-block-end: 0;
    }
    .ocx-ui-skeleton__cell {
      display: block;
      padding: var(--ocx-space-4) var(--ocx-space-5);
    }
    .ocx-ui-skeleton__tr[data-head] {
      --_bar: var(--ocx-color-border);
      font-size: var(--ocx-text-2xs);
      background: var(--ocx-color-surface-subtle);
    }
    .ocx-ui-skeleton__tr[data-head] > .ocx-ui-skeleton__cell {
      padding: var(--ocx-space-3) var(--ocx-space-5);
    }
    /* Code and Terminal: one framed box, a title bar over a body. Code is the Expressive Code frame: the body
       is the code area (--_pad, no --_min floor) and the title is EC's 36px bar (--_head), both set inline.
       Terminal is the Terminal frame: the player area at the Terminal's own min-height (control-xl +
       2 × control-3xl at the default 3 lines, one control-3xl more per line). */
    .ocx-ui-skeleton:is([data-variant='code'], [data-variant='terminal']) {
      --_bar: var(--ocx-color-border);
      display: flex;
      flex-direction: column;
      overflow: clip;
      background: var(--ocx-color-code-bg);
      border: var(--ocx-border-width) solid var(--ocx-color-border);
      border-radius: var(--ocx-radius-lg);
    }
    .ocx-ui-skeleton[data-variant='terminal'] {
      container-type: inline-size; /* 100cqi in a sized terminal's --_min */
    }
    .ocx-ui-skeleton__chrome {
      box-sizing: border-box;
      block-size: var(--_head, auto);
      align-items: center;
      display: flex;
      justify-content: center;
      padding: var(--ocx-space-3) var(--ocx-space-4);
      font-size: var(--ocx-text-sm);
      line-height: var(--ocx-lh-heading);
      background: var(--ocx-color-surface-subtle);
    }
    .ocx-ui-skeleton__chrome > .ocx-ui-skeleton__line {
      inline-size: 30%; /* ponytail: the title, raw until a skeleton token exists */
    }
    .ocx-ui-skeleton__body {
      display: flex;
      flex-direction: column;
      min-block-size: var(--_min, calc(var(--ocx-control-xl) + (var(--_lines) - 1) * var(--ocx-control-3xl)));
      padding: var(--_pad, var(--ocx-space-4));
      font-size: var(--ocx-text-base);
      line-height: var(--ocx-lh-code);
    }
    .ocx-ui-skeleton__chrome + .ocx-ui-skeleton__body {
      border-block-start: var(--ocx-border-width) solid var(--ocx-color-border);
    }
  }
</style>
