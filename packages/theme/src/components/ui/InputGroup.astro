---
// InputGroup (C-262): the c-input box around slots `start`, default (the control) and `end`.
// Focus, invalid and disabled are drawn by field.css from the control's own state; no JS.
import type { HTMLAttributes } from 'astro/types';
import './field.css';

export interface Props extends HTMLAttributes<'div'> {
  /** Greyed box (also derived from a `:disabled` `.ocx-ui-input-group__input`). */
  disabled?: boolean;
  /** Danger border (also derived from an `aria-invalid="true"` control). */
  invalid?: boolean;
  /** Children wrap onto rows (chips before the control). */
  wrap?: boolean;
}

const { disabled = false, invalid = false, wrap = false, class: className, ...rest } = Astro.props;
---

<div
  class:list={['ocx-ui-input-group', className]}
  data-disabled={disabled ? '' : undefined}
  data-invalid={invalid ? '' : undefined}
  data-wrap={wrap ? '' : undefined}
  {...rest}
>
  <slot name="start" />
  <slot />
  <slot name="end" />
</div>
