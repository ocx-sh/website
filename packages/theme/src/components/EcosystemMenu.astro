---
// Ecosystem mega-menu (C-023, C-190, C-191): the header navigation-menu's ecosystem Content, a
// popover the machine shows and hides (JS off: the trigger's `popovertarget` opens it). The rail
// is a vertical Zag `tabs` (automatic activation) that navigation-menu.zag.mjs starts with the
// nav; `:has(:hover, :focus-within)` previews an item's name, meta and `desc` in the strip.
import * as tabs from './tabs.zag.mjs';
import { NAV_ID, RAIL_ID, connect, ids, lean, machine, parts } from './navigation-menu.zag.mjs';
import Icon from './ui/Icon.astro';
import { ssrApi, ssrAttrs } from './ui/zag-runtime.mjs';
import nav from '../nav.json';

const MAX_CATEGORIES = 4;
const MAX_ITEMS = 5;

const hubs = nav.hubs.map((h) => ({
  ...h,
  categories: h.categories.slice(0, MAX_CATEGORIES).map((c) => {
    const items = nav.entries.filter((e) => e.hub === h.id && e.category === c.id);
    return { ...c, items: items.slice(0, MAX_ITEMS), more: Math.max(0, items.length - MAX_ITEMS) };
  }),
}));
const section = nav.sections.find((s) => !('href' in s))?.id ?? 'ecosystem';
const content = parts(ssrApi(machine, connect, { id: NAV_ID, ids })).content(section);
const rail = ssrApi(tabs.machine, tabs.connect, { id: RAIL_ID, orientation: 'vertical', defaultValue: hubs[0]?.id });
---

{/* A nav landmark named by its trigger (aria-labelledby, from Zag). */}
<nav class="ocx-mega" popover {...ssrAttrs(lean(content, { nav: true }))}>
  <div class="ocx-mega__body" {...ssrAttrs(lean(rail.getRootProps()))}>
    <div class="ocx-mega__rail">
      <div {...ssrAttrs(lean(rail.getListProps()))}>
        {hubs.map((h) => (
          <button class="ocx-mega__tab" {...ssrAttrs(lean(rail.getTriggerProps({ value: h.id })))}>
            {h.label}
          </button>
        ))}
      </div>
      <div class="ocx-mega__hub-links">
        {hubs.map((h) => (
          <a class="ocx-mega__hub-link" href={h.href} aria-label={h.all.replace(/\s*→$/, '')}>
            <Icon name="arrow-right" />
          </a>
        ))}
      </div>
    </div>
    {hubs.map((h) => (
      <div class="ocx-mega__panel" data-ocx-hub={h.id} {...ssrAttrs(lean(rail.getContentProps({ value: h.id })))}>
        {h.categories.map((c) => (
          <div class="ocx-mega__category" data-ocx-category={c.id}>
            <p class="ocx-mega__category-label">{c.label}</p>
            <ul class="ocx-mega__items">
              {c.items.map((e) => (
                <li class="ocx-mega__item">
                  {e.href ? (
                    <a class="ocx-mega__link" href={e.href} aria-describedby={`ocx-mega-desc-${e.id}`}>
                      {e.label}
                      <Icon name="arrow-right" />
                    </a>
                  ) : (
                    <span class="ocx-mega__link">{e.label}</span>
                  )}
                  <span class="ocx-mega__preview">
                    <span class="ocx-mega__preview-head" aria-hidden="true">
                      <span class="ocx-mega__name">{e.label}</span>
                      <span class="ocx-mega__meta">{e.meta}</span>
                    </span>
                    <span class="ocx-mega__desc" id={`ocx-mega-desc-${e.id}`}>
                      {e.desc}
                    </span>
                  </span>
                </li>
              ))}
              {c.more > 0 && (
                <li class="ocx-mega__item">
                  <a class="ocx-mega__more" href={h.href}>{`${c.more} more →`}</a>
                </li>
              )}
            </ul>
          </div>
        ))}
      </div>
    ))}
    <p class="ocx-mega__strip">
      {hubs.map((h) => (
        <span class="ocx-mega__blurb" data-ocx-hub={h.id}>
          <span class="ocx-mega__name">{h.label}</span>
          <span class="ocx-mega__desc-line">{h.blurb}</span>
        </span>
      ))}
    </p>
  </div>
</nav>

<style is:global>
  @layer ocx {
    .ocx-mega {
      /* Mock OcxHeader panel geometry: 620px wide, 168px rail, 76px strip. */
      --_width: calc(var(--ocx-sidebar-width) * 2 + var(--ocx-space-11) + var(--ocx-space-6) - var(--ocx-space-2));
      --_rail: calc(var(--ocx-space-12) + var(--ocx-space-9) + var(--ocx-space-3));
      --_strip: calc(var(--ocx-space-11) - var(--ocx-space-2));
      --_row: calc(var(--ocx-space-7) - var(--ocx-space-1));

      position: fixed;
      inset: var(--ocx-header-height) var(--ocx-space-6) auto auto;
      width: var(--_width);
      max-width: calc(100vw - var(--ocx-space-7));
      margin: 0;
      padding: 0;
      z-index: var(--ocx-z-popover);
      color: var(--ocx-color-fg);
      background: var(--ocx-color-surface);
      border: var(--ocx-border-width) solid var(--ocx-color-border);
      border-radius: var(--ocx-radius-xl);
      box-shadow: var(--ocx-shadow-overlay);
      font-family: var(--ocx-font-sans);
      overflow: hidden;
    }
    /* Progressive enhancement: right-align to the ecosystem trigger. */
    @supports (anchor-name: --x) {
      .ocx-header__nav [data-ocx-section='ecosystem'] {
        anchor-name: --ocx-ecosystem;
      }
      /* Right edge on the trigger's, but never past the viewport's start (641–800px the trigger
         sits left of the 620px panel's width). */
      .ocx-mega {
        position-anchor: --ocx-ecosystem;
        inset-inline-end: auto;
        inset-inline-start: max(var(--ocx-space-3), calc(anchor(end) - min(var(--_width), 100vw - var(--ocx-space-7))));
      }
    }

    .ocx-mega__body {
      display: grid;
      grid-template-columns: var(--_rail) minmax(0, 1fr);
      grid-template-rows: auto var(--_strip);
    }

    /* Rail: the vertical tablist, with each hub's "all →" link laid over the end of its row
       (a tablist owns tabs only, so the links are a sibling column in the same cell). */
    .ocx-mega__rail {
      grid-row: 1 / span 2;
      display: grid;
      min-width: 0;
      padding: var(--ocx-space-3);
      background: var(--ocx-color-surface-subtle);
      border-inline-end: var(--ocx-border-width) solid var(--ocx-color-border);
    }
    .ocx-mega__rail > * {
      grid-area: 1 / 1;
      display: flex;
      flex-direction: column;
      gap: var(--ocx-space-2);
      min-width: 0;
    }
    .ocx-mega__hub-links {
      justify-self: end;
    }
    .ocx-mega__tab {
      box-sizing: border-box;
      display: flex;
      align-items: center;
      height: var(--ocx-space-8);
      min-width: 0;
      padding: 0 var(--ocx-space-7) 0 var(--ocx-space-4);
      font: inherit;
      font-size: var(--ocx-text-base);
      font-weight: var(--ocx-font-weight-semibold);
      color: var(--ocx-color-fg);
      text-align: start;
      background: none;
      border: var(--ocx-border-width) solid transparent;
      border-radius: var(--ocx-radius-md);
      cursor: pointer;
    }
    .ocx-mega__tab:hover {
      color: var(--ocx-color-fg-muted);
    }
    .ocx-mega__tab[data-selected] {
      color: var(--ocx-color-accent-fg);
      background: var(--ocx-color-surface);
      border-color: var(--ocx-color-border);
    }
    .ocx-mega__tab:focus-visible {
      outline: var(--ocx-focus-ring);
      outline-offset: calc(var(--ocx-focus-offset) * -1);
    }
    .ocx-mega__hub-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: var(--ocx-space-7);
      height: var(--ocx-space-8);
      color: var(--ocx-color-fg-subtle);
    }
    .ocx-mega__hub-link:hover {
      color: var(--ocx-color-fg);
    }

    /* Panels: all share one grid cell, so the body is as tall as the tallest hub and switching
       tabs never resizes. Zag hides the unselected ones; they keep their box, invisible (and so
       out of the tab order). The strip shows the selected hub's blurb. */
    .ocx-mega__panel {
      grid-column: 2;
      grid-row: 1;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-content: start;
      gap: var(--ocx-space-6) var(--ocx-space-5);
      padding: var(--ocx-space-5);
    }
    .ocx-mega__panel[hidden] {
      visibility: hidden;
    }
    .ocx-mega__panel:focus-visible {
      outline: var(--ocx-focus-ring);
      outline-offset: calc(var(--ocx-focus-offset) * -1);
    }
    .ocx-mega__blurb {
      display: none;
    }
    /* ponytail: ordinal rail↔blurb pairing, written out for up to 4 hubs; add a line per extra hub. */
    .ocx-mega:has(.ocx-mega__tab:nth-of-type(1)[data-selected]) .ocx-mega__blurb:nth-of-type(1),
    .ocx-mega:has(.ocx-mega__tab:nth-of-type(2)[data-selected]) .ocx-mega__blurb:nth-of-type(2),
    .ocx-mega:has(.ocx-mega__tab:nth-of-type(3)[data-selected]) .ocx-mega__blurb:nth-of-type(3),
    .ocx-mega:has(.ocx-mega__tab:nth-of-type(4)[data-selected]) .ocx-mega__blurb:nth-of-type(4) {
      display: grid;
    }
    .ocx-mega__blurb {
      grid-template-rows: auto auto;
    }

    .ocx-mega__category {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }
    .ocx-mega__category-label {
      margin: 0;
      padding: 0 var(--ocx-space-3) var(--ocx-space-3);
      font-family: var(--ocx-font-mono);
      font-size: var(--ocx-text-2xs);
      font-weight: var(--ocx-font-weight-semibold);
      letter-spacing: var(--ocx-tracking-caps);
      text-transform: uppercase;
      color: var(--ocx-color-fg-subtle);
    }
    .ocx-mega__items {
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .ocx-mega__link,
    .ocx-mega__more {
      display: flex;
      align-items: center;
      gap: var(--ocx-space-2);
      height: var(--_row);
      padding: 0 var(--ocx-space-3);
      font-size: var(--ocx-text-base);
      font-weight: var(--ocx-font-weight-medium);
      color: var(--ocx-color-fg);
      text-decoration: none;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      border-radius: var(--ocx-radius-md);
    }
    .ocx-mega__more {
      font-family: var(--ocx-font-mono);
      font-size: var(--ocx-text-xs);
      color: var(--ocx-color-fg-muted);
    }
    .ocx-mega__link svg {
      display: none;
      width: var(--ocx-space-4);
      height: var(--ocx-space-4);
      margin-inline-start: auto;
      flex-shrink: 0;
      color: var(--ocx-color-fg-subtle);
    }
    .ocx-mega__hub-link svg {
      width: var(--ocx-space-4);
      height: var(--ocx-space-4);
    }
    /* Hover/focus previews only: a subtle row, never coral. */
    .ocx-mega__item:is(:hover, :focus-within) :is(.ocx-mega__link, .ocx-mega__more) {
      background: var(--ocx-color-surface-subtle);
    }
    .ocx-mega__item:is(:hover, :focus-within) .ocx-mega__link svg {
      display: block;
    }
    .ocx-mega :is(a, .ocx-mega__link):focus-visible {
      outline: var(--ocx-focus-ring);
      outline-offset: calc(var(--ocx-focus-offset) * -1);
    }

    /* Strip: the checked hub's blurb, or the hovered/focused item's preview,
       laid over the same 76px cell (the popover is their containing block). */
    .ocx-mega__strip {
      grid-column: 2;
      grid-row: 2;
      margin: 0;
      min-width: 0;
      border-top: var(--ocx-border-width) solid var(--ocx-color-border);
      background: var(--ocx-color-surface-subtle);
    }
    .ocx-mega__blurb,
    .ocx-mega__preview {
      align-content: center;
      gap: var(--ocx-space-2);
      height: 100%;
      min-width: 0;
      padding: 0 var(--ocx-space-6);
      box-sizing: border-box;
    }
    .ocx-mega__preview {
      display: none;
      position: absolute;
      inset: auto 0 0 var(--_rail);
      height: calc(var(--_strip) - var(--ocx-border-width));
      background: var(--ocx-color-surface-subtle);
    }
    .ocx-mega__item:is(:hover, :focus-within) .ocx-mega__preview {
      display: grid;
    }
    .ocx-mega__preview-head {
      display: flex;
      align-items: baseline;
      gap: var(--ocx-space-3);
      min-width: 0;
      white-space: nowrap;
      overflow: hidden;
    }
    .ocx-mega__name {
      font-size: var(--ocx-text-base);
      font-weight: var(--ocx-font-weight-semibold);
      color: var(--ocx-color-fg);
    }
    .ocx-mega__meta {
      font-family: var(--ocx-font-mono);
      font-size: var(--ocx-text-xs);
      color: var(--ocx-color-fg-subtle);
    }
    .ocx-mega__desc,
    .ocx-mega__desc-line {
      font-size: var(--ocx-text-sm);
      line-height: 1.4; /* no line-height token yet (WP3) */
      color: var(--ocx-color-fg-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* ≤ 640px the header trigger is hidden and the mobile menu's opens the
       panel: full width under the header, one column, scrolling if tall. */
    @container ocx-header (max-width: 640px) {
      .ocx-mega {
        inset: var(--ocx-header-height) var(--ocx-space-3) auto;
        width: auto;
        max-width: none;
        max-height: calc(100dvh - var(--ocx-header-height) - var(--ocx-space-3));
        overflow-y: auto;
      }
      .ocx-mega__panel {
        grid-template-columns: minmax(0, 1fr);
      }
    }
  }
</style>
