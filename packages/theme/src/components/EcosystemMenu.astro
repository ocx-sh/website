---
// Ecosystem mega-menu (C-023, C-190, C-191): the header navigation-menu's ecosystem Content, a
// popover the machine shows and hides (JS off: the trigger's `popovertarget` opens it). The rail
// is a vertical Zag `tabs` (automatic activation) that navigation-menu.zag.mjs starts with the
// nav; `:has(:hover, :focus-within)` previews an item's name, meta and `desc` in the strip.
import * as tabs from './tabs.zag.mjs';
import { NAV_ID, RAIL_ID, connect, ids, lean, machine, parts } from './navigation-menu.zag.mjs';
import Icon from './ui/Icon.astro';
import { ssrApi, ssrAttrs } from './ui/zag-runtime.mjs';
import nav from '../nav.json';

const MAX_CATEGORIES = 4;
const MAX_ITEMS = 5;

const hubs = nav.hubs.map((h) => ({
  ...h,
  categories: h.categories.slice(0, MAX_CATEGORIES).map((c) => {
    const items = nav.entries.filter((e) => e.hub === h.id && e.category === c.id);
    return { ...c, items: items.slice(0, MAX_ITEMS), more: Math.max(0, items.length - MAX_ITEMS) };
  }),
}));
const section = nav.sections.find((s) => !('href' in s))?.id ?? 'ecosystem';
const content = parts(ssrApi(machine, connect, { id: NAV_ID, ids })).content(section);
const rail = ssrApi(tabs.machine, tabs.connect, { id: RAIL_ID, orientation: 'vertical', defaultValue: hubs[0]?.id });
---

{/* A nav landmark named by its trigger (aria-labelledby, from Zag). */}
<nav class="ocx-mega" popover {...ssrAttrs(lean(content, { nav: true }))}>
  <div class="ocx-mega__body" {...ssrAttrs(lean(rail.getRootProps()))}>
    <div class="ocx-mega__rail">
      <div {...ssrAttrs(lean(rail.getListProps()))}>
        {hubs.map((h) => (
          <button class="ocx-mega__tab" data-pin={h.pinned} {...ssrAttrs(lean(rail.getTriggerProps({ value: h.id })))}>
            {h.label}
          </button>
        ))}
      </div>
      <div class="ocx-mega__hub-links">
        {hubs.map((h) => (
          <a class="ocx-mega__hub-link" data-pin={h.pinned} href={h.href} aria-label={h.all.replace(/\s*→$/, '')}>
            <Icon name="arrow-right" />
          </a>
        ))}
      </div>
    </div>
    {hubs.map((h) => (
      <div class="ocx-mega__panel" data-ocx-hub={h.id} {...ssrAttrs(lean(rail.getContentProps({ value: h.id })))}>
        {h.categories.map((c) => (
          <div class="ocx-mega__category">
            <p class="ocx-mega__category-label">{c.label}</p>
            <ul class="ocx-mega__items">
              {c.items.map((e) => (
                <li>
                  {e.href ? (
                    <a class="ocx-mega__link" href={e.href} aria-describedby={`d${nav.entries.indexOf(e)}`}>
                      {e.label}
                      <Icon name="arrow-right" />
                    </a>
                  ) : (
                    <span class="ocx-mega__link">{e.label}</span>
                  )}
                  <span class="ocx-mega__preview" data-meta={e.meta} aria-hidden="true">
                    {e.label}
                    <span class="ocx-mega__desc" id={e.href ? `d${nav.entries.indexOf(e)}` : undefined}>
                      {e.desc}
                    </span>
                  </span>
                </li>
              ))}
              {c.more > 0 && (
                <li>
                  <a class="ocx-mega__more" href={h.href}>{`${c.more} more →`}</a>
                </li>
              )}
            </ul>
          </div>
        ))}
      </div>
    ))}
    <p class="ocx-mega__strip">
      {hubs.map((h) => (
        <span class="ocx-mega__blurb" data-ocx-hub={h.id}>
          {h.label}
          <span class="ocx-mega__desc-line">{h.blurb}</span>
        </span>
      ))}
    </p>
  </div>
</nav>
