---
// Header tree shared by the Starlight `Header` override and Shell. Starlight-free: the search trigger
// comes in through the `search` slot. Without `brand` it renders the ocx.sh chrome from nav.json
// (sections, ecosystem menu, install, GitHub, theme toggle); with `brand` a neutral header (brand,
// plain links, theme toggle). Classes are styled by base.css plus the block below.
import ocx from '../nav.json';
import logo from '../logo.svg?raw';
import { currentHref, EXTERNAL_LABEL, externalLink, sectionLinks } from '../nav.mjs';
import { renderShell } from '../shell-render.mjs';
import { shellRev } from '../shell-rev.mjs';
import DrawerItems from '../shell/DrawerItems.astro';
import Sections from '../shell/Sections.astro';
import EcosystemMenu from './EcosystemMenu.astro';
import { NAV_ID, connect, ids, lean, machine, parts } from './navigation-menu.zag.mjs';
import Icon from './ui/Icon.astro';
import { ssrApi, ssrAttrs } from './ui/zag-runtime.mjs';
import ThemeSelect from '../starlight/ThemeSelect.astro';

export interface Props {
  /** ocx mode: the active section id (`data-ocx-active`). Neutral mode ignores it. */
  active?: string;
  /** Neutral mode: a mirror's own brand. Absent means the ocx.sh chrome. */
  brand?: { title: string; wordmark?: string; logoSrc?: string; logoAlt?: string } | undefined;
  /**
   * Neutral mode: the header links. `match: 'prefix'` on a home link (`/` or the base) keeps it current
   * under that prefix when no longer link matches (D-138); `title` is a tooltip.
   */
  nav?: { label: string; href: string; title?: string; match?: 'prefix' }[] | undefined;
  /** ocx mode (D-139): the consumer's own header links, plain entries after the nav.json sections. */
  extraNav?: { label: string; href: string; title?: string }[] | undefined;
  /** Render a mobile menu button (native popover, no JavaScript) listing the sections / links. */
  menu?: boolean;
}

const { active = '', brand, nav = [], extraNav = [], menu = false } = Astro.props;
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
// C-190: hover opens after 200 ms (Zag's default, pinned here), click toggles; the close delay
// leaves room to cross from the trigger into the panel below it.
const zag = { openDelay: 200, closeDelay: 300 };
const part = parts(ssrApi(machine, connect, { ...zag, id: NAV_ID, ids }));
const github = ocx.actions.find((a) => a.id === 'github');
const install = ocx.actions.find((a) => a.id === 'install');
// D-126: one current link, the longest matching prefix (`/` and `/docs/` are not both current on `/docs/x/`).
const current = currentHref(path, nav, base);
// D-139: in ocx mode a consumer link that matches the path is more specific than the nav.json section claim,
// so it alone is current.
const extraCurrent = brand ? undefined : currentHref(path, extraNav, base);
const shown = extraCurrent === undefined ? active : '';
// The drawer's items: the nav.json ones (the live header swaps these), then the consumer's own.
const drawerMain = brand
  ? nav.map((l) => ({ label: l.label, href: l.href, current: l.href === current }))
  : sectionLinks(ocx, path).map((l) => ({ ...l, current: l.current && extraCurrent === undefined }));
const drawerExtra = brand
  ? []
  : extraNav.map((l) => ({ label: l.label, href: l.href, current: l.href === extraCurrent }));
// D-141: a neutral header with no links has nothing to open, so it renders no menu button.
const hasMenu = menu && drawerMain.length + drawerExtra.length > 0;
const ext = (l: { label: string; href: string; title?: string }) => ({ ...l, ...externalLink(l.href) });
// r10: the rev of the nav baked here (on the nav root below), named by the same hash as the root site's fragment (shell/Fragment.astro);
// the loader in chrome.mjs swaps in the live nav when the site publishes another.
const navRev = brand ? undefined : shellRev(await renderShell());
---

{/* The nav's `mount` runs in chrome.mjs, the page's one early script: a script of its own was one more
early request, which cost Lighthouse performance (0.99) on pages whose LCP waits on a body stylesheet. */}
<div class="ocx-header" data-ocx-active={brand ? undefined : shown}>
  {brand ? (
    <a class="ocx-header__brand" href={import.meta.env.BASE_URL} aria-label={`${brand.title} home`}>
      {brand.logoSrc && (
        <span class="ocx-header__logo">
          <img src={brand.logoSrc} width="20" height="20" alt={brand.logoAlt ?? ''} />
        </span>
      )}
      <span>{brand.wordmark ?? brand.title}</span>
    </a>
  ) : (
    /* D-R3 fallback: an inline copy, not <Logo>. Logo's global CSS would inline into every page
    and push the HTML past the first-RTT window (plan_zag-adoption.md, Refinement D-R3). */
    <a class="ocx-header__brand" href={ocx.brand.href} aria-label="ocx home">
      <Fragment
        set:html={logo.replace(
          '<svg xmlns="http://www.w3.org/2000/svg" ',
          '<svg width="20" height="20" aria-hidden="true" ',
        )}
      />
      <span>{ocx.brand.wordmark}</span>
    </a>
  )}
  <slot name="search" />
  <div class="ocx-header__end">
    {brand ? (
      <nav class="ocx-header__nav" aria-label="Main">
        {nav.map(ext).map((l) => (
          <a href={l.href} title={l.title} aria-current={l.href === current ? 'page' : undefined} {...l.attrs}>
            {l.label}
            {l.out && <Icon name="external" size="sm" label={EXTERNAL_LABEL} />}
          </a>
        ))}
      </nav>
    ) : (
      <>
        {/* The Zag root holds the nav and, as its sibling, the ecosystem Content: base.css's
        `.ocx-header__nav a` rules and the <= 640px `display: none` never reach the panel. */}
        <div
          class="ocx-header__sections"
          data-zag-root="navigation-menu"
          data-zag-state="idle"
          data-zag-id={NAV_ID}
          data-zag-props={JSON.stringify(zag)}
          {...ssrAttrs(lean(part.root, { nav: true }))}
          data-nav-rev={navRev}
        >
          <nav class="ocx-header__nav" aria-label="ocx sections">
            <ul {...ssrAttrs(lean(part.list, { nav: true }))}>
              <Sections part={part} shown={shown} />
              {/* D-139: the consumer's own links, plain entries beside the sections. */}
              {extraNav.map(ext).map((l) => (
                <li>
                  <a
                    href={l.href}
                    title={l.title}
                    data-ocx-section="extra"
                    aria-current={l.href === extraCurrent ? 'page' : undefined}
                    {...l.attrs}
                  >
                    {l.label}
                    {l.out && <Icon name="external" size="sm" label={EXTERNAL_LABEL} />}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <EcosystemMenu />
        </div>
        {install && (
          <a
            class="ocx-header__install"
            href={install.href}
            data-ocx-section="install"
            aria-current={shown === 'install' ? 'page' : undefined}
          >
            {install.label}
          </a>
        )}
      </>
    )}
    <span class="ocx-header__tools">
      {!brand && github && (
        <a class="ocx-header__tool" href={github.href} aria-label={github.label} rel="noopener">
          <Icon name="github" class="ocx-header__tool-icon" />
        </a>
      )}
      <ThemeSelect />
      {hasMenu && (
        <button
          class="ocx-header__tool ocx-header__menu"
          type="button"
          popovertarget="ocx-header-menu"
          aria-label="Menu"
        >
          <Icon name="menu" class="ocx-header__tool-icon" />
        </button>
      )}
    </span>
  </div>
  {hasMenu && (
    <nav id="ocx-header-menu" class="ocx-header__drawer" popover aria-label={brand ? 'Main' : 'ocx sections'}>
      <ul>
        <DrawerItems links={drawerMain} />
        <DrawerItems links={drawerExtra} />
      </ul>
    </nav>
  )}
</div>
