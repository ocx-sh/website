---
// Starlight `Sidebar` override (C-230, D-Z5). The top level is the design's flat list: a group is a
// mono-caps label over its entries, never collapsed. Nested groups are plain markup toggled by one
// delegated controller (sidebar-controller.mjs, no Zag), which chrome.mjs, Search.astro's every-page
// script, loads on the first touch of the sidebar, so no page pays a script request for them. Starlight's persistence is kept: `sl-sidebar-state-persist`
// with Starlight's sidebar hash inside `#starlight__sidebar`, the `sl-sidebar-state` sessionStorage
// entry (`open[]` by nested-group index, `scroll`), restored at ≥ 50em by an inline script right
// after the list, before first paint; Starlight's own script (Page.astro) still saves the scroll on
// page hide. Styles: starlight.css, badges included: Starlight's Badge component would inline
// its stylesheet into every page (htmlGz), so a badge is its `.sl-badge <variant>` span only.
// DOM budget (C-112): a link's and a group's label is bare text, not Starlight's wrapping <span>, and a
// nested group is its <li> (root), <button> (trigger) and <ul> (content), no wrapper <div>s.
import type { StarlightRouteData } from '@astrojs/starlight/route-data';
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import { configSidebar } from 'virtual:ocx-theme/sidebar';
import { groupKey, hash32, servedGroups } from './sidebar-groups.mjs';

type Entry = StarlightRouteData['sidebar'][number];
type Group = Extract<Entry, { type: 'group' }>;

interface Props {
  /** Internal (recursion): the list to render and its depth; the sidebar itself renders with none. */
  entries?: Entry[];
  depth?: number;
  /** Internal: each nested group's index in document order (its id and its `open[]` slot). */
  index?: Map<Group, number>;
  /** Internal: a nested group's content part, spread on its list (no wrapper element). */
  attrs?: Record<string, unknown>;
}

const { depth = 0 } = Astro.props;
// Collapsed groups without the current page load their links after the page (frag-sidebar.astro serves them).
const served = servedGroups(configSidebar);
const base = `${import.meta.env.BASE_URL}frag/sidebar/`.replace('//', '/');
const top = Astro.props.entries === undefined;
const entries = Astro.props.entries ?? Astro.locals.starlightRoute.sidebar;

const hasCurrent = (g: Group): boolean => g.entries.some((e) => (e.type === 'link' ? e.isCurrent : hasCurrent(e)));

// Top call only: number the nested groups (pre-order = document order) and hash the sidebar.
const index = Astro.props.index ?? new Map<Group, number>();
let hash = '';
if (top) {
  const walk = (list: Entry[], d: number) => {
    for (const e of list)
      if (e.type === 'group') {
        if (d > 0) index.set(e, index.size);
        walk(e.entries, d + 1);
      }
  };
  walk(entries, 0);
  // Starlight 0.42's getSidebarHash (utils/navigation, not exported): labels and hrefs, not the current page.
  const identity = (list: Entry[]): string =>
    list.map((e) => (e.type === 'group' ? e.label + identity(e.entries) : e.label + e.href)).join('');
  const id = identity(entries);
  hash = hash32(id).padStart(7, '0');
}
const groups = index.size > 0;
const linkCount = (g: Group): number => g.entries.reduce((n, e) => n + (e.type === 'link' ? 1 : linkCount(e)), 0);
const deferred = (g: Group) => served?.has(groupKey(g)) && g.collapsed && !hasCurrent(g);
const anyDeferred = top && [...index.keys()].some(deferred);

// Pre-paint restore, inline and hand-minified: every page carries it (htmlGz). `p` is the persist
// element, `s` the stored state when it names this sidebar. With nested groups it also flips each
// stored group (the `hidden` and `aria-expanded` the controller reads) and saves every change, by the group's id number
// (its place in the whole sidebar, so a deferred group's missing nested groups shift no other group's slot). When no mount
// marked `p` by DOMContentLoaded (Search overridden, or its script failed), the groups take the error
// state, whose rule shows their content: no page becomes unreachable.
// Without JS every nested group shows its content; a deferred one has none, so it is hidden and "All pages" (first
// in the list) stands in for it.
const noscriptCss = `<style>@layer ocx{#starlight__sidebar [data-collapsible][hidden]{display:block}${anyDeferred ? '#starlight__sidebar li:has(>[data-defer]){display:none}' : ''}}</style>`;
// A deferred group the restore left open wakes the sidebar controller (chrome.mjs armed it for a touch) once mounted, so its links
// load at once: a touch of its own, sent from here to keep that code out of the every-page script.
const WAKE = anyDeferred
  ? `g.forEach(d=>d.querySelector('[data-defer]:not([hidden])')&&d.dispatchEvent(new Event('focusin',{bubbles:true})))`
  : 'void 0';
const SCROLL = `p.closest('#starlight__sidebar').scrollTop=s.scroll`;
const persist = groups
  ? `(()=>{try{const p=document.currentScript.parentElement,k='sl-sidebar-state',h=p.dataset.hash,g=[...p.querySelectorAll('[data-zag-root=collapsible]')],r=()=>{try{const s=JSON.parse(sessionStorage.getItem(k)||'0');if(s?.hash===h&&Array.isArray(s.open))return s}catch{}return{hash:h,open:[]}},s=r();p.addEventListener('ocx:collapsible:change',e=>{try{const t=r();t.open[+e.target.dataset.zagId.slice(3)]=e.detail.open;sessionStorage.setItem(k,JSON.stringify(t))}catch{}});addEventListener('DOMContentLoaded',()=>'mounted'in p.dataset?${WAKE}:g.forEach(d=>d.dataset.zagState='error'));if(!matchMedia('(min-width: 50em)').matches)return;g.forEach(d=>{const o=s.open[+d.dataset.zagId.slice(3)];if(typeof o!='boolean')return;const t=d.firstElementChild,c=t.nextElementSibling;t.setAttribute('aria-expanded',o);c.hidden=!o});if(s.scroll)${SCROLL}}catch{}})()`
  : `(()=>{try{const p=document.currentScript.parentElement,s=JSON.parse(sessionStorage.getItem('sl-sidebar-state')||'0');if(s.hash===p.dataset.hash&&matchMedia('(min-width: 50em)').matches)${SCROLL}}catch{}})()`;

/** A link's own attributes; its `class` joins ours (as Starlight's). */
const omitClass = (attrs: Record<string, unknown>) =>
  Object.fromEntries(Object.entries(attrs).filter(([k]) => k !== 'class'));

/** One nested group's parts (C-130a): the list is open when it holds the current page or is not collapsed. */
function group(g: Group) {
  const id = `sb-${index.get(g)}`;
  const open = hasCurrent(g) || !g.collapsed;
  return {
    id,
    open: open ? ('true' as const) : ('false' as const),
    content: { id: `${id}-c`, 'data-part': 'content', 'data-collapsible': '', hidden: !open },
  };
}
---

{top ? (
  <>
    <sl-sidebar-state-persist data-hash={hash} data-frag={anyDeferred ? base : undefined}>
      {anyDeferred && (
        <noscript>
          <a href={`${base}_all/`}>All pages</a>
          <Fragment set:html={noscriptCss} />
        </noscript>
      )}
      <Astro.self entries={entries} depth={0} index={index} />
      {groups && !anyDeferred && (
        <noscript>
          <Fragment set:html={noscriptCss} />
        </noscript>
      )}
      <script is:inline aria-hidden="true" set:html={persist} />
    </sl-sidebar-state-persist>
    <div class="md:sl-hidden">
      <MobileMenuFooter />
    </div>
  </>
) : (
  <ul class={depth === 0 ? 'top-level' : undefined} {...Astro.props.attrs}>
    {entries.map((e) =>
      e.type === 'link' ? (
        <li>
          <a
            href={e.href}
            aria-current={e.isCurrent ? 'page' : undefined}
            {...omitClass(e.attrs)}
            class:list={[{ large: depth === 0 }, e.attrs.class]}
          >
            {e.label}
            {e.badge && <span class:list={['sl-badge', e.badge.variant, e.badge.class]}>{e.badge.text}</span>}
          </a>
        </li>
      ) : depth === 0 ? (
        <li>
          <span class="group-label">
            {e.label}
            {e.badge && <span class:list={['sl-badge', e.badge.variant, e.badge.class]}>{e.badge.text}</span>}
          </span>
          <Astro.self entries={e.entries} depth={1} index={index} />
        </li>
      ) : (
        (() => {
          const p = group(e);
          return (
            <li data-zag-root="collapsible" data-zag-state="idle" data-zag-id={p.id}>
              <button type="button" data-part="trigger" aria-controls={p.content.id} aria-expanded={p.open}>
                {e.label}
                {e.badge && <span class:list={['sl-badge', e.badge.variant, e.badge.class]}>{e.badge.text}</span>}
              </button>
              {deferred(e) ? (
                <ul {...p.content} style={`--n:${linkCount(e)}`} data-defer={groupKey(e)} />
              ) : (
                <Astro.self entries={e.entries} depth={depth + 1} index={index} attrs={p.content} />
              )}
            </li>
          );
        })()
      ),
    )}
  </ul>
)}
