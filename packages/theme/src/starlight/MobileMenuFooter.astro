---
// Starlight `MobileMenuFooter` override: the default layout with the OCX icon
// toggle instead of the "Auto ▾" select. The section links are MobileSections,
// the first block of the pane (C-023).
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import config from 'virtual:starlight/user-config';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from './ThemeSelect.astro';
---

<div class="mobile-preferences sl-flex">
  <div class="social-icons">
    <SocialIcons />
  </div>
  <ThemeSelect />
  {/* Rendered only with several locales: its script would otherwise ship to every page (htmlGz). */}
  {config.isMultilingual && <LanguageSelect />}
</div>

<style is:global>
  @layer ocx {
    /* Starlight's own MobileMenuFooter layout (its scoped CSS does not reach a
       copied tree), on tokens. */
    .social-icons {
      display: flex;
      align-items: center;
      gap: var(--ocx-space-5);
      margin-inline-end: auto;
      padding-block: var(--ocx-space-5);
    }
    .social-icons:empty {
      display: none;
    }
    .mobile-preferences {
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      column-gap: var(--ocx-space-5);
      padding: var(--ocx-space-3) 0;
      border-top: var(--ocx-border-width) solid var(--ocx-color-border);
    }
  }
</style>
