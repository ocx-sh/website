---
// Starlight `TableOfContents` override: the default TOC plus "edit this page ↗"
// (only with `editLink.baseUrl`) and "report an issue ↗" (C-027).
import TocList from './TocList.astro';
import nav from '../nav.json';
import options from 'virtual:ocx-theme/options';
import { claimFor } from '../nav.mjs';
import { probe } from '../components/toc-probe.mjs';

const { editUrl, toc } = Astro.locals.starlightRoute;
const claim = claimFor(nav, Astro.url.pathname);
// The fold (plugin option `foldOutline`, default on): an outline of 10 rows or more folds each section's subsections
// under its title. Ten rows (23.6 px each) stand about 240 px tall, a third of a 768 px laptop screen: an outline that
// short reads at a glance, and folding it would hide rows to save no space. Every showcase page (5 to 9 rows) stays flat.
type Row = { children: Row[] };
const rows = (items: Row[]): number => items.reduce((n, h) => n + 1 + rows(h.children), 0);
const fold =
  options.foldOutline !== false && !!toc && rows(toc.items) >= 10 && toc.items.some((h) => h.children.length > 0);
// End of page (owner finding): Starlight's scroll-spy band sits near the top, so short trailing
// sections never reach it and get skipped. Instead of its choice, `probe` (toc-probe.mjs, inlined
// via `String`) slides a line from Starlight's own band top (just under `scroll-padding-top`, where
// a jump lands a heading) to the viewport bottom over the last screen of scroll, so every entry
// lights in order and the last one at the bottom; the `location.hash` target stays current while
// the view sits where the jump put it. It is the only spy: it runs on scroll/resize (each fires at
// most once a frame: no rAF throttle) once the elements are defined (toc-elements.mjs: each is the
// `current` setter this calls, with no observer of its own). Inline and hand-minified (a string, so
// no formatter expands it): every docs page pays these HTML bytes. The rows (`a`) are the desktop
// outline's; the phone outline, whose list arrives on its first open, marks its own copy of the row.
// The fold (`F`, desktop outline): a section is open when the reader set it by hand (`b.o`, which then wins for good),
// else when it holds the current row (`c`) or the focus. It runs before first paint (this script follows the outline,
// the page has not painted yet) with the `location.hash` row, then on a section button's click and after the spy on
// each scroll or resize, never on the spy's first pass: what first paint shows stays until the reader moves.
const FOLD =
  '=a.find(l=>l.hash==location.hash),F=()=>d.querySelectorAll("button").forEach(b=>{let u=b.nextElementSibling,' +
  'o=b.o??(b.parentNode.contains(c)||u.contains(document.activeElement));b.hidden=0;b.setAttribute("aria-expanded",o);u.hidden=!o;' +
  'b.onclick=()=>{b.o=!o;F()}})';
const TAIL =
  '{let d=document.querySelector("starlight-toc"),T=document.querySelectorAll("starlight-toc,mobile-starlight-toc"),' +
  'a=[...d.querySelectorAll("a")],c' +
  (fold ? FOLD : '') +
  ',P=' +
  String(probe)
    .replace(/\s*\n\s*/g, '')
    .replace(/\s*([-=,;:?(){}<>+*/&|!])\s*/g, '$1') +
  ',g=()=>{c=a[P(a.map(l=>document.getElementById(decodeURIComponent(l.hash.slice(1)))?.getBoundingClientRect().top??1/0),' +
  'parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop)||0,' +
  'innerHeight,document.documentElement.scrollHeight,scrollY,a.findIndex(l=>l.hash==location.hash))]||a[0];' +
  'T.forEach(t=>t.current=c)};' +
  (fold ? 'F();' : '') +
  'customElements.whenDefined("mobile-starlight-toc").then(()=>{addEventListener("scroll",g);addEventListener("resize",g);' +
  (fold ? 'addEventListener("scroll",F);addEventListener("resize",F);' : '') +
  'g()})}';
---

{toc && (
  <starlight-toc data-min-h={toc.minHeadingLevel} data-max-h={toc.maxHeadingLevel}>
    <nav aria-labelledby="starlight__on-this-page">
      <h2 id="starlight__on-this-page">{Astro.locals.t('tableOfContents.onThisPage')}</h2>
      <TocList toc={toc.items} fold={fold} />
    </nav>
  </starlight-toc>
)}
<script>
  import './toc-elements.mjs';
</script>
{toc && <script is:inline set:html={TAIL} />}
<ul class="ocx-toc-links">
  {editUrl && (
    <li>
      <a href={editUrl.href} rel="noopener">
        edit this page ↗
      </a>
    </li>
  )}
  {claim && (
    <li>
      <a href={`https://github.com/${claim.repo}/issues/new`} rel="noopener">
        report an issue ↗
      </a>
    </li>
  )}
</ul>

<style is:global>
  @layer ocx {
    /* Mock #1b: a sharp 2px bar per entry, coral on the current one — Starlight
       rounds its TOC links (0.25rem), which bends the bar and the highlight. */
    starlight-toc a,
    mobile-starlight-toc a {
      border-radius: var(--ocx-radius-md);
    }
    /* Section (h2) rows are titles: ink and semibold (the 600 face is loaded; there is no 500). Only the top level is
       named, so the muted default of starlight.css, the h3 rows, the hover ink and the current accent stay as they are. */
    starlight-toc > nav > ul > li > a,
    mobile-starlight-toc .dropdown > ul > li > a {
      font-weight: var(--ocx-font-weight-semibold);
      color: var(--ocx-color-fg);
    }
    starlight-toc a[aria-current='true'] {
      background: none;
    }
    /* Nested entries (h3+, a nested <ul> per Starlight's own TOC recursion) read as a lower
       tier: smaller and lighter than the top-level h2 rows (ink, semibold), on top of starlight.css's per-depth
       indent and guide rule and its muted colour. */
    starlight-toc ul ul a,
    mobile-starlight-toc ul ul a {
      font-size: var(--ocx-text-xs);
      font-weight: var(--ocx-font-weight-regular);
    }

    .ocx-toc-links {
      display: flex;
      flex-direction: column;
      gap: var(--ocx-space-2);
      margin: var(--ocx-space-6) 0 0;
      padding: var(--ocx-space-5) 0 0;
      list-style: none;
      border-top: var(--ocx-border-width) solid var(--ocx-color-border);
    }
    .ocx-toc-links a {
      font-family: var(--ocx-font-mono);
      font-size: var(--ocx-text-xs);
      color: var(--ocx-color-fg-subtle);
      text-decoration: none;
      border-radius: var(--ocx-radius-md);
      transition: color var(--ocx-duration-base);
    }
    .ocx-toc-links a:hover {
      color: var(--ocx-color-fg);
    }
  }
</style>
