---
// Starlight's MarkdownContent with two SSR rewrites from tab-icons.mjs: a scroll region
// around each markdown table, so the table itself can fill the column (starlight.css ›
// Markdown tables), and in-content stylesheet links moved ahead of the content (no
// half-styled first paint). A page that links a glossary term also gets the term style, inline; the popup loader is in chrome.mjs, which
// every page already loads (a script of its own was one more request on every page that links a term).
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import termCss from '../components/term-link.css?inline';
import { splitStylesheets, wrapTables } from './tab-icons.mjs';

const { links, rest } = splitStylesheets(wrapTables(await Astro.slots.render('default')));
---

<Fragment set:html={links} />
{rest.includes('class="ocx-term"') && <style is:inline set:html={termCss} />}
<Default>
  <Fragment set:html={rest} />
</Default>
