---
// Starlight `Header` override rendering the canonical OCX header tree
// (classes styled by base.css). Starlight already wraps this in <header>.
import Search from '@astrojs/starlight/components/Search.astro';
import nav from '../nav.json';
import logo from '../logo.svg?url';
import { activeSection } from '../nav.ts';

const active = activeSection(nav, Astro.url.pathname);
const github = nav.actions.find((a) => a.id === 'github');
const install = nav.actions.find((a) => a.id === 'install');
---

<div class="ocx-header" data-ocx-active={active}>
  <a class="ocx-header__brand" href={nav.brand.href} aria-label="ocx home">
    <img src={logo} alt="" width="20" height="20" /><span>{nav.brand.wordmark}</span>
  </a>
  <Search />
  <div class="ocx-header__end">
    <nav class="ocx-header__nav" aria-label="ocx sections">
      {
        nav.sections.map((s) => (
          // ponytail: a menu section links to its first hub until the ecosystem mega-menu lands
          <a
            href={'href' in s ? s.href : s.menu[0]?.href}
            data-ocx-section={s.id}
            aria-current={s.id === active ? 'page' : undefined}>
            {s.label}
          </a>
        ))
      }
    </nav>
    {
      install && (
        <a class="ocx-header__install" href={install.href} data-ocx-section="install">
          {install.label}
        </a>
      )
    }
    {
      github && (
        <a class="ocx-header__tool" href={github.href} aria-label={github.label} rel="noopener">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
          </svg>
        </a>
      )
    }
    <button class="ocx-header__tool" type="button" data-ocx-theme aria-label="Toggle dark mode">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
    </button>
  </div>
</div>

<script>
  // Starlight's ThemeProvider reads localStorage['starlight-theme'] and <html data-theme>.
  for (const btn of document.querySelectorAll('[data-ocx-theme]')) {
    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('starlight-theme', next);
      } catch {
        // Storage blocked (private mode): the toggle still works for this page.
      }
    });
  }
</script>
