---
// Starlight `Search` override on Zag `dialog` (C-210, D-Z4, D-Z11). Starlight 0.42.4's hooks stay:
// `<site-search>`, `button[data-open-modal]`, `button[data-close-modal]`, `#starlight__search`,
// `body[data-search-modal-open]`, and its Pagefind options. The machine loads on the first trigger
// click or Ctrl/⌘K (manual trigger); Pagefind UI loads on the first open, never at idle.
import project from 'virtual:starlight/project-context';
import Icon from '../components/ui/Icon.astro';
import { ssrApi, ssrAttrs } from '../components/ui/zag-runtime.mjs';
import { connect, machine } from './search.zag.mjs';

const label = Astro.locals.t('search.label');
// Starlight's Pagefind translations, unchanged.
const translations = {
  placeholder: label,
  ...Object.fromEntries(
    Object.entries(Astro.locals.t.all())
      .filter(([key]) => key.startsWith('pagefind.'))
      .map(([key, value]) => [key.replace('pagefind.', ''), value]),
  ),
};
const id = 'search';
const zag = { 'aria-label': label };
const api = ssrApi(machine, connect, { ...zag, id });
// Zag assumes a description part (its `rendered` defaults to true) and points aria-describedby
// at it; there is none, so SSR and `render` (search.zag.mjs) both drop the reference.
const content = { ...api.getContentProps(), 'aria-describedby': undefined };
---

<site-search
  class={Astro.props.class}
  data-zag-root="dialog"
  data-zag-id={id}
  data-zag-props={JSON.stringify(zag)}
  data-zag-state="idle"
  data-zag-trigger="manual"
  data-translations={JSON.stringify(translations)}
  data-strip-trailing-slash={project.trailingSlash === 'never' ? '' : undefined}
>
  <button {...ssrAttrs(api.getTriggerProps())} data-open-modal aria-label={label} aria-keyshortcuts="Control+K">
    <Icon name="search" />
    <span class="sl-hidden md:sl-block" aria-hidden="true">
      {label}
    </span>
    {/* The platform key is CSS (`html[data-platform]`, set before paint by Head.astro): no script here. */}
    <kbd class="sl-hidden md:sl-flex">
      <kbd class="ocx-search__ctrl">{Astro.locals.t('search.ctrlKey')}</kbd>
      <kbd class="ocx-search__cmd">⌘</kbd>
      <kbd>K</kbd>
    </kbd>
  </button>
  {/* Top layer (manual popover): the header's stacking context and the fixed mobile menu toggle
  stay below the open dialog, as they did below Starlight's modal <dialog>. */}
  <div class="ocx-search__layer" popover="manual">
    <div {...ssrAttrs(api.getBackdropProps())}></div>
    <div {...ssrAttrs(content)}>
      <button {...ssrAttrs(api.getCloseTriggerProps())} data-close-modal class="sl-flex md:sl-hidden">
        {Astro.locals.t('search.cancelLabel')}
      </button>
      {import.meta.env.DEV ? (
        <p class="ocx-search__dev" dir="ltr">
          {Astro.locals.t('search.devWarning')}
        </p>
      ) : (
        <div id="starlight__search" />
      )}
    </div>
  </div>
</site-search>

<script>
  import { mount } from '../components/ui/zag.mjs';
  import { mountChrome } from '../chrome.mjs';

  // Toaster, theme toggles, header nav, sidebar groups and mobile drawer (chrome.mjs): one early script.
  mountChrome(document);

  // The outline's marker fades only after the reader scrolls or points at it (starlight.css,
  // D-R7 c): the TOC's init pass, which marks the first entry, stays a snap.
  const tocs = document.querySelectorAll<HTMLElement>('starlight-toc');
  const tocLive = () => tocs.forEach((toc) => (toc.dataset['live'] = ''));
  if (tocs.length) {
    addEventListener('scroll', tocLive, { once: true, passive: true });
    tocs[0]?.addEventListener('pointerover', tocLive, { once: true });
  }

  type Api = { open: boolean; setOpen: (open: boolean) => void };

  const root = document.querySelector<HTMLElement>('site-search[data-zag-root="dialog"]');
  if (root) {
    // No replay: the start signal is outside the root (Ctrl/⌘K) or already consumed, so each
    // signal sets the open state itself once the machine is live.
    // The dialog's styles are search-results.css: the machine counts as loaded only once that sheet has (or failed
    // to, or 3 s passed), so the first open never paints an unstyled dialog and never waits on a broken sheet.
    const load = () =>
      Promise.all([
        import('./search.zag.mjs'),
        import('./search-skin.mjs').then((m) => m.loadSkin()).catch(() => undefined),
      ]).then(([machine]) => machine);
    const handle = mount(root, { load, trigger: 'manual', replay: false });
    // The state the reader asked for, until the machine reports it: presses that land before the
    // machine is live (or before its api refreshes) each flip this, not a stale `api.open`.
    let wanted: boolean | undefined;
    root.addEventListener('ocx:search:change', () => (wanted = undefined));
    const toggle = (open?: boolean) => {
      const next = open ?? !(wanted ?? (handle.api as Api | undefined)?.open ?? false);
      wanted = next;
      // Pending until the machine and the skin have arrived: the trigger says so (and a slow sheet is not a dead click).
      trigger?.setAttribute('aria-busy', 'true');
      return handle
        .start()
        .then(() => (handle.api as Api | undefined)?.setOpen(next))
        .finally(() => trigger?.removeAttribute('aria-busy'));
    };
    const trigger = root.querySelector('[data-open-modal]');
    // The name only (not painted): the hint's ⌘ is CSS, from Head.astro's `html[data-platform]`.
    if (document.documentElement.dataset['platform'] === 'mac') trigger?.setAttribute('aria-keyshortcuts', 'Meta+K');
    // The first touch of the trigger warms the machine chunk and both skin sheets (the same moment an interaction root
    // starts), so the open that follows finds them; nothing loads before it. `load` is idempotent: imports and the skin are cached.
    // A failed warm is silent: the open that follows starts the same load and shows its own failure state.
    const warm = () => void load().catch(() => {});
    for (const type of ['pointerenter', 'focusin', 'touchstart'])
      trigger?.addEventListener(type, warm, { once: true, passive: true });
    // Before the machine is live the trigger opens it; after, Zag's own trigger props do.
    trigger?.addEventListener('click', () => void (root.dataset['zagState'] === 'idle' && toggle(true)));
    // The one Ctrl/⌘K listener on the page (Starlight's is gone with its component). After a load
    // error the browser keeps its own shortcut.
    window.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key === 'k' && root.dataset['zagState'] !== 'error') {
        event.preventDefault();
        void toggle();
      }
    });
  }
</script>

<style is:global>
  /* Starlight 0.42.4's trigger rules, verbatim and in Starlight's layer as its Search.astro ships them (bound to
   * that component, so they move with the override). Pagefind's own sheet and results skin are search-results.css,
   * loaded before the dialog first opens. The theme's `starlight.css` and Header.astro (layer ocx) restyle on top. */

  @layer starlight.core {
    /* Starlight's component-scoped trigger and cancel-button rules, scoped here by `site-search`. */
    site-search {
      display: contents;
    }
    site-search button[data-open-modal] {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      border: 0;
      background-color: transparent;
      color: var(--sl-color-gray-1);
      cursor: pointer;
      height: 2.5rem;
      font-size: var(--sl-text-xl);
    }
    @media (min-width: 50rem) {
      site-search button[data-open-modal] {
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 0.5rem;
        padding-inline-start: 0.75rem;
        padding-inline-end: 0.5rem;
        background-color: var(--sl-color-black);
        color: var(--sl-color-gray-2);
        font-size: var(--sl-text-sm);
        width: 100%;
        max-width: 22rem;
      }
      site-search button[data-open-modal]:hover {
        border-color: var(--sl-color-gray-2);
        color: var(--sl-color-white);
      }
      site-search button[data-open-modal] > :last-child {
        margin-inline-start: auto;
      }
    }
    site-search button[data-open-modal] > svg {
      font-size: 1em;
      width: 1em;
      height: 1em;
    }
    site-search button > kbd {
      border-radius: 0.25rem;
      font-size: var(--sl-text-2xs);
      gap: 0.25em;
      padding-inline: 0.375rem;
      background-color: var(--sl-color-gray-6);
    }
    site-search kbd {
      font-family: var(--__sl-font);
    }
    site-search button[data-close-modal] {
      position: absolute;
      z-index: 1;
      align-items: center;
      align-self: flex-end;
      height: calc(64px * var(--pagefind-ui-scale));
      padding: 0.25rem;
      border: 0;
      background: transparent;
      cursor: pointer;
      color: var(--sl-color-text-accent);
    }
  }

  /* The trigger's hover ink fades (D-R7): colour and border. The dialog's own rules are search-results.css. */
  @layer ocx {
    site-search button[data-open-modal] {
      transition:
        color var(--ocx-duration-base),
        border-color var(--ocx-duration-base);
    }
  }

  /* The shortcut hint (Starlight's inline script, as CSS): Head.astro sets `html[data-platform]` before
   * paint, so the key is final on first paint; without script there is no shortcut, so no hint. In
   * ocx, after starlight.utils' `md:sl-flex`. */
  @layer ocx {
    :root:not([data-platform]) site-search button > kbd,
    :root[data-platform='mac'] .ocx-search__ctrl,
    :root:not([data-platform='mac']) .ocx-search__cmd {
      display: none;
    }
  }
</style>
