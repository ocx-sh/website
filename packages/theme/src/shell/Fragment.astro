---
// The live header (r10): the parts of the ocx.sh header a nav.json change touches, each in a
// `<template data-shell-part>` named by SHELL_PARTS. Rendered from the header's own components with
// no site-specific state (no active section, no current link, no extraNav, no search): the loader
// in chrome.mjs keeps those. The root site publishes it at `/_shell/v1/<rev>/nav.html`; SiteHeader
// renders it too, only to name its baked nav by the same rev. Links are root-relative, ocx.sh-wide.
import ocx from '../nav.json';
import { NAV_ID, connect, ids, machine, parts } from '../components/navigation-menu.zag.mjs';
import EcosystemMenu from '../components/EcosystemMenu.astro';
import { ssrApi } from '../components/ui/zag-runtime.mjs';
import { sectionLinks } from '../nav.mjs';
import DrawerItems from './DrawerItems.astro';
import Sections from './Sections.astro';

const part = parts(ssrApi(machine, connect, { id: NAV_ID, ids }));
---

<template data-shell-part="sections">
  <Sections part={part} />
</template>
<template data-shell-part="mega">
  <EcosystemMenu />
</template>
<template data-shell-part="drawer">
  <DrawerItems links={sectionLinks(ocx, '').map((l) => ({ ...l, current: false }))} />
</template>
