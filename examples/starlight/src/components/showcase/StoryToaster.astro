---
// A story page's toaster (`toaster: true`): the C-181 root exactly as the theme's Footer.astro
// renders it, and the glue that Starlight pages run from Search.astro's every-page script. Its own
// component so only toaster stories load the glue; imported under `?story` (see toaster-story.d.ts).
---

<div
  data-zag-root="toast"
  data-zag-state="idle"
  data-zag-trigger="manual"
  data-zag-id="ocx-toaster"
  data-zag-props="{}"
  aria-live="polite"
></div>

<script>
  import { installToaster } from '@ocx-sh/theme/toaster?story';

  installToaster(document);
</script>
