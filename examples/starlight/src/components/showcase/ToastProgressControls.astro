---
// The toast showcase's "loading with progress" demo: one button starts a loading toast and moves its
// ring by id (`progress`, 0–100), then settles it to success. Same shape as ToastControls: the
// wiring is a lazy chunk, out of the page HTML.
---

<div class="showcase-actions">
  <button type="button" class="showcase-action" data-toast-progress>
    loading with progress
  </button>
</div>

<script>
  void import('./toast-progress-controls.mjs');
</script>
