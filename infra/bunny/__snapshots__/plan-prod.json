      "Description": "ocx:assets-edge",
      "Triggers": [
        {
          "Type": 0,
          "PatternMatchingType": 0,
          "Parameter1": "",
          "PatternMatches": [
            "https://*/_astro/*"
          ]
        },
        {
          "Type": 8,
          "PatternMatchingType": 0,
          "Parameter1": "",
          "PatternMatches": [
            "200"
