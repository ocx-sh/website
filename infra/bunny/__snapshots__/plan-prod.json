      "ActionType": 3,
      "ActionParameter1": "31536000",
      "ActionParameter2": "",
      "TriggerMatchingType": 1,
      "Enabled": true,
      "Description": "ocx:assets-edge",
      "Triggers": [
        {
          "Type": 0,
          "PatternMatchingType": 0,
          "Parameter1": "",
          "PatternMatches": [
            "https://*/_astro/*"
          ]
        },
        {
          "Type": 8,
          "PatternMatchingType": 0,
          "Parameter1": "",
          "PatternMatches": [
            "200"
          ]
        }
      ]
    },
    {
      "ActionType": 16,
      "ActionParameter1": "31536000",
      "ActionParameter2": "",
      "TriggerMatchingType": 1,
      "Enabled": true,
      "Description": "ocx:assets-browser",
      "Triggers": [
        {
          "Type": 0,
          "PatternMatchingType": 0,
          "Parameter1": "",
          "PatternMatches": [
            "https://*/_astro/*"
          ]
        },
        {
          "Type": 8,
          "PatternMatchingType": 0,
          "Parameter1": "",
          "PatternMatches": [
            "200"
          ]
        }
      ]
    },
    {
      "ActionType": 5,
      "ActionParameter1": "X-Robots-Tag",
