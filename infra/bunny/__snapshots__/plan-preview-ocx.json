      "ActionParameter1": "X-Robots-Tag",
      "ActionParameter2": "noindex, nofollow",
      "TriggerMatchingType": 0,
      "Enabled": true,
      "Description": "ocx:noindex",
      "Triggers": [
        {
          "Type": 0,
          "PatternMatchingType": 0,
